{
  "name": "orbit-buddy",
  "version": "1.0.0",
  "description": "A playful desktop companion for Windows",
  "main": "app/main.js",
  "author": "Orbit Buddy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "studio.orbitbuddy.desktop",
    "productName": "Orbit Buddy",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orbit Buddy"
    },
    "artifactName": "Orbit-Buddy-Setup-${version}.${ext}"
  }
}
